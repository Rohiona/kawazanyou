{
  "name": "kawazanyou",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "tsc --noEmit && WRANGLER_LOG_PATH=.wrangler/wrangler.log vite build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite preview",
    "test": "npm run build && node --test tests/*.test.mjs tests/*.test.ts",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:local:migrate": "wrangler d1 migrations apply site-creator-d1 --local --config wrangler.local.jsonc --persist-to .wrangler/state"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "hono": "4.11.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260515.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "typescript": "7.0.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
